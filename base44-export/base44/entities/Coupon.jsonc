{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Unique coupon token, e.g. GH-8F42K9"
    },
    "discount_percent": {
      "type": "number",
      "default": 15
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "used"
      ],
      "default": "active"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token",
    "expires_at",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}