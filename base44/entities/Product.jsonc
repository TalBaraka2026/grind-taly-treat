{
  "name": "Product",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "hot_drinks",
        "iced_drinks",
        "summer_drinks",
        "desserts",
        "addons"
      ]
    },
    "name_en": {
      "type": "string"
    },
    "name_ar": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "calories": {
      "type": "number"
    },
    "image": {
      "type": "string"
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "category",
    "name_en",
    "name_ar"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}